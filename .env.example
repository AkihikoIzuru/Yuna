# 9Router Configuration
YUNA_BASE_URL=http://localhost:20128/v1
YUNA_MODEL=yuna
YUNA_FAST_MODEL=yuna
ROUTER_API_KEY=sk-your-api-key-here

# Identitas Asisten (opsional - default di config.py)
# ASSISTANT_NAME=Yuna
# ASSISTANT_FULLNAME=Your Unified Network Assistant
# PROJECT_CODENAME=Project Hearth
# ASSISTANT_ID=YNA-HRT-001
# USER_NICKNAME=Kak Akii

# Optional: Weather API (untuk tool get_weather Fase 1)
# OPENWEATHER_API_KEY=your_key_here
# WEATHER_API_KEY=your_key_here

# Optional: Home Assistant (Fase 4)
# YUNA_HA_URL=http://homeassistant.local:8123
# YUNA_HA_TOKEN=your_long_lived_token

# Optional: Mikrotik RouterOS (Fase 4)
# YUNA_MIKROTIK_HOST=10.x.x.1
# YUNA_MIKROTIK_USER=yuna
# YUNA_MIKROTIK_PASSWORD=password

# Audio (Fase 2)
# WHISPER_MODEL=small
# TTS_VOICE=id-ID-GadisNeural
# TTS_RATE=+3%
# TTS_PITCH=+3Hz
# WAKE_WORD=hey yuna
# WAKE_BACKEND=auto
# WAKE_PHRASES=yuna,yu na,yuuna,juna,yona,una
# AUDIO_INPUT_DEVICE=
# AUDIO_OUTPUT_DEVICE=

# Desktop App (Fase 7)
# DATA_DIR=%APPDATA%\Yuna
# LOG_DIR=%APPDATA%\Yuna\logs
# UI_HOST=127.0.0.1
# UI_PORT=8080
# AUTO_START=false
# TRAY_TOOLTIP=Yuna

# Persona (default: yuna, bisa 'netral')
# PERSONA=yuna